[0.015074, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;36mSPECIFY\u001b[0m  Keep intent readable, with precise contracts underneath.\r\n\r\n\u001b[1;32m$\u001b[0m sed -n 8,15p specify.spec/areas/overview.yaml\r\n"]
[0.723626, "o", "  - id: no-args-returns-json-manifest\r\n    title: Agent-readable command discovery\r\n    rationale:\r\n      A structured manifest lets agents discover supported commands and global options predictably\r\n      without parsing prose or guessing.\r\n    description: >-\r\n      Running with no arguments exits 0 and outputs JSON with commands, global options, and exit\r\n      codes.\r\n"]
[7.730978, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;36mSPECIFY\u001b[0m  Give agents the same capture / review / reconcile workflow.\r\n\r\n"]
[7.731021, "o", "\u001b[1;32m$\u001b[0m specify spec init --spec specify.spec\r\n"]
[8.516864, "o", "{\r\n  \"path\": \"/private/tmp/specify-demo.3JRzt3/AGENTS.md\",\r\n  \"spec\": \"/private/tmp/specify-demo.3JRzt3/specify.spec\",\r\n  \"initialized\": true\r\n}\r\n"]
[13.526871, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;36mSPECIFY\u001b[0m  Check structure. Project tests still check application behavior.\r\n\r\n"]
[13.526884, "o", "\u001b[1;32m$\u001b[0m specify spec lint --spec specify.spec\r\n"]
[14.308786, "o", "\u001b[1;32m✓ Spec is valid\u001b[0m"]
[14.308845, "o", "\r\n"]
