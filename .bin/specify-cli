#!/usr/bin/env node
/**
 * .bin/specify-cli — Argos specify-cli contract implementation for the specify repo.
 *
 * Implements: status, verify, activity, open
 * Exit codes: 0=ok, 1=usage/bad-args, 2=auth, 3=daemon-unreachable, 4=not-found
 */

import { spawnSync } from 'node:child_process';
import { readFileSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = resolve(__dirname, '..');

// Store paths
const SPECIFY_DIR = resolve(REPO_ROOT, '.specify');
const ACTIVITY_FILE = resolve(SPECIFY_DIR, 'activity-log.jsonl');
const SPEC_PATH = resolve(REPO_ROOT, 'specify.spec');

// ── helpers ──────────────────────────────────────────────────────────────────

function parseArgs(argv) {
  const flags = {};
  for (const arg of argv) {
    if (arg.startsWith('--')) {
      const eq = arg.indexOf('=');
      if (eq !== -1) {
        flags[arg.slice(2, eq)] = arg.slice(eq + 1);
      } else {
        flags[arg.slice(2)] = true;
      }
    }
  }
  return flags;
}

function die(msg, code = 1) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

function out(obj) {
  process.stdout.write(JSON.stringify(obj) + '\n');
}

// ── subcommands ───────────────────────────────────────────────────────────────

function cmdStatus() {
  const running = existsSync(SPEC_PATH);
  out({
    running,
    mode: 'local',
    specPath: SPEC_PATH,
    lastVerifyAt: existsSync(resolve(SPECIFY_DIR, 'verify/verify-result.json'))
      ? (readFileSync(resolve(SPECIFY_DIR, 'verify/verify-result.json'), 'utf8').match(
          /"updatedAt"\s*:\s*"([^"]+)"/,
        )?.[1] ?? null)
      : null,
  });
}

function cmdVerify(_flags) {
  const verifyResultPath = resolve(SPECIFY_DIR, 'verify/verify-result.json');
  if (!existsSync(verifyResultPath)) {
    out({ verified: false, missingMarkers: [], reason: 'No recorded results' });
    return;
  }
  const checked = spawnSync(
    resolve(REPO_ROOT, 'specify'),
    ['verify', '--spec', SPEC_PATH, '--report', verifyResultPath, '--json'],
    { encoding: 'utf8', timeout: 60000 },
  );
  try {
    const result = JSON.parse(checked.stdout);
    const missing = result.valid
      ? [
          ...result.missingIds,
          ...result.report.results.filter((r) => r.status !== 'passed').map((r) => r.id),
        ]
      : [];
    out({
      verified: checked.status === 0 && result.valid === true && result.report.pass === true,
      missingMarkers: missing.map((id) => ({ section: id.split('/')[0], expectedMarker: id })),
      ...(result.valid ? {} : { reason: 'Invalid recorded results' }),
    });
  } catch {
    out({ verified: false, missingMarkers: [], reason: 'Results validation failed' });
  }
}

function cmdActivity(flags) {
  const since = flags.since ? new Date(flags.since) : new Date(Date.now() - 86400000);
  const events = [];

  if (existsSync(ACTIVITY_FILE)) {
    for (const line of readFileSync(ACTIVITY_FILE, 'utf8').split('\n').filter(Boolean)) {
      try {
        const e = JSON.parse(line);
        if (new Date(e.ts) >= since) events.push(e);
      } catch {}
    }
  }

  out(events);
}

function cmdOpen(flags) {
  const id = flags.id;
  if (id) {
    process.stdout.write(`https://github.com/gm2211/specify/issues/${id}\n`);
  } else {
    process.stdout.write(`${SPEC_PATH}\n`);
  }
  process.exit(0);
}

// ── main ──────────────────────────────────────────────────────────────────────

const [, , subcmd, ...rest] = process.argv;
const flags = parseArgs(rest);

switch (subcmd) {
  case 'status':
    cmdStatus();
    break;
  case 'verify':
    cmdVerify(flags);
    break;
  case 'activity':
    cmdActivity(flags);
    break;
  case 'open':
    cmdOpen(flags);
    break;
  default:
    die(
      `Usage: specify-cli <subcommand> [flags]\n` +
        `Subcommands: status, verify, activity, open`,
      1,
    );
}
